{
  "schema": "fragment-training-kit-site-v1",
  "python": "/shared/your-npu-environment/bin/python",
  "cann_env": "/usr/local/Ascend/cann-8.5.0/set_env.sh",
  "inventory": "/shared/your-private-site/verified-ascend-inventory.json",
  "registry": "/shared/your-private-site/ascend-fleet-registry.json",
  "cards": 2,
  "global_card_limit": 64,
  "steps": 20,
  "mode": "external-loss",
  "replacement": false,
  "fault_step": 3,
  "join_transport": "device",
  "bucket_mib": 512,
  "phase_timeout": 600,
  "collective_timeout": 120,
  "heartbeat_timeout": 15,
  "control_poll_seconds": 0.01,
  "job_runtime_seconds": 1800,
  "environment": {
    "HCCL_RDMA_TIMEOUT": "12",
    "HCCL_BUFFSIZE": "512"
  },
  "source_dirs": [],
  "training_config": {
    "resident_adapter": "fragment_training_kit.examples.toy_regression:create_engine",
    "resident_rng_scheme": "toy-orthogonal256-canonical-position-v1",
    "resident_precision_contract": "native FP32 parameters and FP32 AdamW moments; no FP32 master",
    "seed": 7,
    "batch_size": 256,
    "worker_microbatch_size": 4,
    "microbatch_size": 4,
    "disable_activation_checkpointing": true,
    "resident_data_workers": 0,
    "resident_final_state": "checkpoint",
    "resident_verify_every": 5,
    "target_steps": 20,
    "decay_steps": 20,
    "peak_lr": 0.05,
    "end_lr": 0.05,
    "warmup_steps": 0,
    "clip_gradient_norm": 10.0
  }
}
